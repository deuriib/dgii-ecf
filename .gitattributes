# Normalize line endings to LF across the whole repo.
* text=auto eol=lf

# Binary-ish / generated artifacts.
*.p12 binary
*.pem binary
*.pfx binary
*.key binary

# DGII XML Schemas are provenance-checked by sha256; store them verbatim.
*.xsd -text

# Lockfiles are text (diffable, mergeable).
*.lock text eol=lf

# Linguist hints.
packages/typescript/src/** linguist-language=TypeScript
packages/python/src/** linguist-language=Python
